---
import BaseLayout from './BaseLayout.astro';
import Section from '../components/Section.astro';
import DonateButtons from '../components/DonateButtons.astro';

interface Props {
  title: string;
  description?: string;
  programTitle: string;
  tagline: string;
  heroImage?: string;
  eyebrow?: string;
  donateFunds?: ('general' | 'communityCenter' | 'hopeFund')[];
}

const {
  title,
  description,
  programTitle,
  tagline,
  heroImage,
  eyebrow = 'A Sparrow Program',
  donateFunds = ['general', 'communityCenter', 'hopeFund'],
} = Astro.props;
---

<BaseLayout title={title} description={description}>
  <!-- Program hero -->
  <section class="bg-sparrow-green-dark text-white">
    <div class="mx-auto grid max-w-content items-center gap-8 px-4 py-16 sm:px-6 md:grid-cols-2 md:py-24">
      <div>
        <p class="font-sans text-sm uppercase tracking-wide text-sparrow-gold">{eyebrow}</p>
        <h1 class="mt-2 font-serif text-4xl font-semibold text-white sm:text-5xl">{programTitle}</h1>
        <p class="mt-4 max-w-prose text-lg text-white/90">{tagline}</p>
      </div>
      {
        heroImage && (
          <img
            src={heroImage}
            alt=""
            class="aspect-[4/3] w-full rounded-2xl object-cover shadow-card"
            loading="eager"
          />
        )
      }
    </div>
  </section>

  <slot />

  <!-- Shared closing CTA -->
  <Section bg="green-dark">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-2xl font-semibold sm:text-3xl">Be part of the work</h2>
      <p class="mt-3 text-white/85">
        Every gift and every volunteer helps a family find stability and hope.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <DonateButtons funds={donateFunds} />
        <a href="/get-involved" class="inline-flex items-center justify-center rounded-2xl border border-white/60 px-6 py-3 font-sans font-medium text-white transition hover:bg-white/10">Volunteer</a>
      </div>
    </div>
  </Section>
</BaseLayout>
