---
import BaseLayout from './BaseLayout.astro';
import Section from '../components/Section.astro';
import DonateButtons from '../components/DonateButtons.astro';

interface Props {
  title: string;
  description?: string;
  programTitle: string;
  tagline: string;
  heroImage?: string;
}

const { title, description, programTitle, tagline, heroImage } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <!-- Program hero -->
  <section class="bg-sparrow-green text-white">
    <div class="mx-auto grid max-w-content items-center gap-8 px-4 py-16 sm:px-6 md:grid-cols-2 md:py-24">
      <div>
        <p class="font-sans text-sm uppercase tracking-wide text-sparrow-gold">A Sparrow Program</p>
        <h1 class="mt-2 font-serif text-4xl font-semibold text-white sm:text-5xl">{programTitle}</h1>
        <p class="mt-4 max-w-prose text-lg text-white/90">{tagline}</p>
      </div>
      {
        heroImage && (
          <img
            src={heroImage}
            alt=""
            class="aspect-[4/3] w-full rounded-2xl object-cover shadow-card"
            loading="eager"
          />
        )
      }
    </div>
  </section>

  <slot />

  <!-- Shared closing CTA -->
  <Section bg="cream">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-2xl font-semibold sm:text-3xl">Be part of the work</h2>
      <p class="mt-3 text-sparrow-gray dark:text-dark-muted">
        Every gift and every volunteer helps a family find stability and hope.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <DonateButtons />
        <a href="/get-involved" class="btn-outline">Volunteer</a>
      </div>
    </div>
  </Section>
</BaseLayout>
