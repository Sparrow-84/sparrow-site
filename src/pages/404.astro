---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
---

<BaseLayout title="Page not found" noindex={true}>
  <Section bg="white">
    <div class="mx-auto max-w-xl text-center">
      <p class="font-serif text-6xl font-semibold text-sparrow-gold">404</p>
      <h1 class="mt-4 text-2xl font-semibold">We couldn't find that page</h1>
      <p class="mt-3 text-sparrow-gray dark:text-dark-muted">The page may have moved. Let's get you back home.</p>
      <a href="/" class="btn-primary mt-6">Back to home</a>
    </div>
  </Section>
</BaseLayout>
