---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';

const STORE_URL = 'https://sparrowmerch.printify.me';
---

<BaseLayout
  title="Shop"
  description="Wear the mission. 100% of profits from Sparrow merch support housing and restoration work in Corvallis."
>
  <Section bg="sage">
    <div class="mx-auto max-w-3xl text-center">
      <p class="font-sans text-sm font-medium uppercase tracking-wide text-sparrow-gold">Sparrow Merch</p>
      <h1 class="mt-2 font-serif text-4xl font-semibold sm:text-5xl">Wear the mission</h1>
      <p class="mt-5 text-lg text-sparrow-ink/80 dark:text-dark-text/80">
        Every purchase directly supports Sparrow's housing and restoration work in Corvallis.
        100% of profits go to the mission.
      </p>
      <div class="mt-8">
        <a href={STORE_URL} target="_blank" rel="noopener" class="btn-primary inline-block">
          Shop now
        </a>
      </div>
    </div>
  </Section>

  <Section bg="white">
    <p class="mx-auto max-w-xl text-center text-sm text-sparrow-gray dark:text-dark-muted">
      Orders are processed securely through our store. Questions? Email{' '}
      <a class="underline hover:text-sparrow-green dark:hover:text-dark-heading" href="mailto:info@sparrowinc.org">
        info@sparrowinc.org
      </a>.
    </p>
  </Section>
</BaseLayout>
