---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';

const STORE_URL = 'https://sparrowmerch.printify.me';
---

<BaseLayout
  title="Shop"
  description="Wear the mission. 100% of profits from Sparrow merch support housing and restoration work in Corvallis."
>
  <Section bg="sage">
    <div class="mx-auto max-w-3xl text-center">
      <p class="font-sans text-sm font-medium uppercase tracking-wide text-sparrow-gold">Sparrow Merch</p>
      <h1 class="mt-2 font-serif text-4xl font-semibold sm:text-5xl">Wear the mission</h1>
      <p class="mt-5 text-lg text-sparrow-ink/80 dark:text-dark-text/80">
        Every purchase directly supports Sparrow's housing and restoration work in Corvallis.
        100% of profits go to the mission.
      </p>
      <div class="mt-8">
        <a href={STORE_URL} target="_blank" rel="noopener" class="btn-primary inline-block">
          Shop now
        </a>
        <p class="mt-3 text-sm text-sparrow-gray dark:text-dark-muted">Online ordering is coming soon — thanks for your patience while we get it set up.</p>
      </div>
    </div>

    {/* One photo per product in the Printify Pop-Up Store. Keep this list in step with the store. */}
    <ul class="mx-auto mt-12 grid max-w-4xl grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-6">
      {[
        { src: '/images/shop/free-hoodie.webp', name: '"FREE" Hoodie', alt: 'Back of the "FREE" hoodie in forest green, with a flock of birds' },
        { src: '/images/shop/free-crewneck.webp', name: '"FREE" Crewneck', alt: 'Back of the "FREE" crewneck sweatshirt in navy, with a flock of birds' },
        { src: '/images/shop/free-tee.webp', name: '"FREE" T-Shirt', alt: 'Two people wearing the "FREE" t-shirt in forest green' },
        { src: '/images/shop/polo.webp', name: 'Sparrow Polo', alt: 'Sparrow polo in forest green with the Sparrow logo on the chest' },
        { src: '/images/shop/beanie-name.webp', name: 'Sparrow Beanie', alt: 'Dark green beanie embroidered with the Sparrow name and bird' },
        { src: '/images/shop/beanie-bird.webp', name: 'Sparrow Bird Beanie', alt: 'Dark navy beanie embroidered with the Sparrow bird' },
      ].map((p) => (
        <li class="overflow-hidden rounded-2xl border border-sparrow-rule bg-white shadow-card dark:border-dark-rule dark:bg-dark-surface">
          <img src={p.src} alt={p.alt} width="800" height="800" class="aspect-square w-full object-cover" loading="lazy" />
          <p class="px-3 py-2 text-center text-sm font-medium">{p.name}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section bg="white">
    <p class="mx-auto max-w-xl text-center text-sm text-sparrow-gray dark:text-dark-muted">
      Orders are processed securely through our store. Questions? Email{' '}
      <a class="underline hover:text-sparrow-green dark:hover:text-dark-heading" href="mailto:info@sparrowinc.org">
        info@sparrowinc.org
      </a>.
    </p>
  </Section>
</BaseLayout>
