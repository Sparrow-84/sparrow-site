---
import { getEntry, getCollection } from 'astro:content';
import ProgramLayout from '../layouts/ProgramLayout.astro';
import Section from '../components/Section.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import { photo } from '../lib/media';

const program = await getEntry('community', 'twin-oaks');
if (!program) throw new Error('Missing community entry: twin-oaks');
const { Content } = await program.render();
const d = program.data;
const faqs = (await getCollection('faqs')).filter((f) => f.data.program === 'twin-oaks');
---

<ProgramLayout
  title="Twin Oaks Community"
  description="Affordable, dignified housing in South Corvallis — a stable foundation for lasting change."
  programTitle={d.title}
  tagline={d.tagline}
  heroImage={photo(d.heroImage)}
>
  <Section bg="white">
    <div class="grid gap-10 md:grid-cols-2">
      <div class="leading-relaxed text-sparrow-ink/90 dark:text-dark-text/90"><Content /></div>
      <div class="rounded-2xl border border-sparrow-rule dark:border-dark-rule bg-sparrow-mist dark:bg-dark-surface p-6">
        <h2 class="text-xl font-semibold">Who it's for</h2>
        <ul class="mt-3 space-y-2">
          {d.eligibility.map((e) => (
            <li class="flex gap-2"><span class="text-sparrow-gold">✓</span><span>{e}</span></li>
          ))}
        </ul>
        <div class="mt-6 border-t border-sparrow-rule dark:border-dark-rule pt-4 text-sm">
          <p class="text-sparrow-gray dark:text-dark-muted">Questions about housing?</p>
          <p class="mt-1"><a class="font-medium text-sparrow-green dark:text-dark-heading" href={`mailto:${d.contactEmail}`}>{d.contactEmail}</a></p>
          {d.contactPhone && <p><a class="font-medium text-sparrow-green dark:text-dark-heading" href={`tel:${d.contactPhone}`}>{d.contactPhone}</a></p>}
        </div>
      </div>
    </div>
  </Section>

  <Section bg="sage">
    <h2 class="text-2xl font-semibold sm:text-3xl">How to apply</h2>
    <ol class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {d.applicationSteps.map((s, i) => (
        <li class="rounded-2xl bg-white dark:bg-dark-surface p-6 shadow-card">
          <div class="flex h-9 w-9 items-center justify-center rounded-full bg-sparrow-green font-serif text-white">{i + 1}</div>
          <h3 class="mt-3 font-serif text-lg">{s.title}</h3>
          <p class="mt-1 text-sm text-sparrow-gray dark:text-dark-muted">{s.detail}</p>
        </li>
      ))}
    </ol>
  </Section>

  {
    d.gallery.length > 0 && (
      <Section bg="white">
        <h2 class="text-2xl font-semibold sm:text-3xl">Life at Twin Oaks</h2>
        <div class="mt-8"><PhotoGallery images={d.gallery} /></div>
      </Section>
    )
  }

  {
    faqs.length > 0 && (
      <Section bg="mist">
        <h2 class="text-2xl font-semibold sm:text-3xl">Common questions</h2>
        <div class="mx-auto mt-8 max-w-3xl"><FAQAccordion faqs={faqs} /></div>
      </Section>
    )
  }
</ProgramLayout>
