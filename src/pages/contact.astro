---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import { CONTACT, SOCIAL, ORG } from '../consts';
---

<BaseLayout title="Contact" description="Get in touch with the Sparrow team in Corvallis, Oregon.">
  <Section bg="sage">
    <div class="mx-auto max-w-3xl">
      <h1 class="font-serif text-4xl font-semibold sm:text-5xl">Let's talk</h1>
      <p class="mt-5 text-lg text-sparrow-ink/80 dark:text-dark-text/80">
        However we can help — a question, a partnership, or just hello — a real person is waiting on
        the other side.
      </p>
    </div>
  </Section>

  <Section bg="white">
    <div class="grid gap-10 md:grid-cols-2">
      <div>
        <h2 class="text-2xl font-semibold sm:text-3xl">Send a message</h2>
        <div class="mt-4"><ContactForm /></div>
      </div>

      <div>
        <h2 class="text-2xl font-semibold sm:text-3xl">Reach us directly</h2>
        <ul class="mt-4 space-y-5 text-sparrow-ink/90 dark:text-dark-text/90">
          <li>
            <p class="font-semibold text-sparrow-green dark:text-dark-heading">General</p>
            <a class="hover:underline" href={`mailto:${CONTACT.general.email}`}>{CONTACT.general.email}</a>
          </li>
          <li>
            <p class="font-semibold text-sparrow-green dark:text-dark-heading">Twin Oaks housing</p>
            <a class="hover:underline" href={`mailto:${CONTACT.twinOaks.email}`}>{CONTACT.twinOaks.email}</a>
            {' · '}
            <a class="hover:underline" href={`tel:${CONTACT.twinOaks.phone}`}>{CONTACT.twinOaks.phone}</a>
          </li>
          <li>
            <p class="font-semibold text-sparrow-green dark:text-dark-heading">LifeChange Program</p>
            <a class="hover:underline" href={`mailto:${CONTACT.lifeChange.email}`}>{CONTACT.lifeChange.email}</a>
            {' · '}
            <a class="hover:underline" href={`tel:${CONTACT.lifeChange.phone}`}>{CONTACT.lifeChange.phone}</a>
          </li>
          <li>
            <p class="font-semibold text-sparrow-green dark:text-dark-heading">Visit</p>
            {ORG.address.street}<br />{ORG.address.city}, {ORG.address.state} {ORG.address.zip}
          </li>
          <li class="flex gap-4 pt-1">
            <a class="font-medium text-sparrow-green dark:text-dark-heading hover:underline" href={SOCIAL.facebook} rel="noopener">Facebook</a>
            <a class="font-medium text-sparrow-green dark:text-dark-heading hover:underline" href={SOCIAL.instagram} rel="noopener">Instagram</a>
          </li>
        </ul>
      </div>
    </div>
  </Section>
</BaseLayout>
