---
// Promo banner pointing to /community-center. Used on the home page and the Twin Oaks page.
import { GIVEBUTTER } from '../consts';
---

<section class="bg-white dark:bg-dark-bg">
  <div class="mx-auto max-w-content px-4 py-10 sm:px-6">
    <div class="grid overflow-hidden rounded-2xl border border-sparrow-gold/50 bg-sparrow-cream shadow-card dark:bg-dark-surface md:grid-cols-[2fr_3fr]">
      <a href="/community-center" class="block" tabindex="-1" aria-hidden="true">
        <img
          src="/images/community-center/south-hero.jpg"
          alt=""
          class="h-48 w-full object-cover md:h-full"
          loading="lazy"
        />
      </a>
      <div class="p-6 sm:p-8">
        <p class="font-sans text-sm font-semibold uppercase tracking-wide text-sparrow-gold">Now raising funds</p>
        <h2 class="mt-1 text-2xl font-semibold sm:text-3xl">We're building a Community Center at Twin Oaks</h2>
        <p class="mt-3 text-sparrow-ink/90 dark:text-dark-text/90">
          A gathering place for Twin Oaks residents and LifeChange participants, planned to break ground in spring 2027.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href="/community-center" class="btn-outline">See the plans</a>
          <a href={GIVEBUTTER.communityCenter} target="_blank" rel="noopener" class="btn-gold">Give to the Community Center</a>
        </div>
      </div>
    </div>
  </div>
</section>
