---
import { WEB3FORMS_KEY, NEWSLETTER, SITE } from '../../consts';

// Until the org's email tool (Brevo) form action is wired into consts.ts, signups
// route through Web3Forms so no one is dropped. Swap NEWSLETTER.action to point at Brevo.
const usingWeb3 = !NEWSLETTER.action;
const action = NEWSLETTER.action || 'https://api.web3forms.com/submit';

// This component renders more than once on some pages (site footer + Get Involved's own
// copy), so the hidden-iframe target needs a per-instance unique name — a single shared
// name/id would let one copy's script silently listen on the wrong copy's form.
const targetName = `newsletter-target-${Math.random().toString(36).slice(2, 10)}`;
---

<form
  action={action}
  method="POST"
  target={usingWeb3 ? undefined : targetName}
  data-newsletter-form
  class="flex flex-col gap-2"
>
  {usingWeb3 && <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />}
  {usingWeb3 && <input type="hidden" name="subject" value="New The Sparrow Monthly signup" />}
  {usingWeb3 && <input type="hidden" name="redirect" value={`${SITE.url}/thank-you`} />}
  {usingWeb3 && <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />}
  {/* Brevo's own honeypot + required locale field, matching its generated form exactly. */}
  {!usingWeb3 && <input type="text" name="email_address_check" value="" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />}
  {!usingWeb3 && <input type="hidden" name="locale" value="en" />}

  {/* Name fields — Brevo path only, matching the FIRSTNAME/LASTNAME attributes configured
      on this form in Brevo's own dashboard. First name required, last name optional —
      mirrors Love INC's signup form, the tone/model this whole site is calibrated against. */}
  {!usingWeb3 && (
    <div class="flex flex-col gap-2 sm:flex-row">
      <input
        type="text"
        name="FIRSTNAME"
        aria-label="First name"
        required
        placeholder="First name"
        class="field-input sm:flex-1"
      />
      <input
        type="text"
        name="LASTNAME"
        aria-label="Last name (optional)"
        placeholder="Last name (optional)"
        class="field-input sm:flex-1"
      />
    </div>
  )}

  <div class="flex flex-col gap-2 sm:flex-row">
    <input
      type="email"
      name={usingWeb3 ? 'email' : 'EMAIL'}
      aria-label="Email address"
      required
      placeholder="you@example.com"
      class="field-input sm:flex-1"
    />
    <button type="submit" class="btn-primary !px-5 !py-2 text-sm">Subscribe</button>
  </div>
</form>

{!usingWeb3 && <iframe name={targetName} class="hidden" aria-hidden="true" tabindex="-1"></iframe>}

{!usingWeb3 && (
  <script is:inline>
    // Deliberately plain JavaScript, no TypeScript syntax (no generics/type annotations) —
    // this file previously used `querySelectorAll<HTMLFormElement>`, and two independent
    // redirect strategies both silently failed to run in real testing, which pointed at the
    // script itself never executing (a parse error kills the whole block, and this syntax is
    // invalid in a browser unless something transpiles it first) rather than either strategy's
    // own logic being wrong. is:inline also guarantees Astro ships this completely as-is,
    // with no bundling/processing step in between that could interfere.
    //
    // Also NOT waiting on the hidden iframe's `load` event to know when to redirect — real
    // testing confirmed the form submission itself succeeds (Brevo creates the contact) but
    // that event never reliably fires, almost certainly because Brevo sets anti-clickjacking
    // headers that block a cross-origin iframe from "loading" their response the normal way,
    // even though the underlying POST still goes through fine. A fixed delay after submit
    // sidesteps that. The button also gets instant visible feedback on click, independent of
    // whether the delayed redirect itself works.
    document.querySelectorAll('form[data-newsletter-form]').forEach(function (form) {
      form.addEventListener('submit', function () {
        var button = form.querySelector('button[type="submit"]');
        if (button) {
          button.disabled = true;
          button.textContent = 'Subscribing…';
        }
        setTimeout(function () {
          window.location.href = '/subscribed';
        }, 1500);
      });
    });
  </script>
)}
