---
import { WEB3FORMS_KEY, NEWSLETTER, SITE } from '../../consts';

// Until the org's email tool (Brevo) form action is wired into consts.ts, signups
// route through Web3Forms so no one is dropped. Swap NEWSLETTER.action to point at Brevo.
const usingWeb3 = !NEWSLETTER.action;
const action = NEWSLETTER.action || 'https://api.web3forms.com/submit';
---

<form
  action={action}
  method="POST"
  target={usingWeb3 ? undefined : 'newsletter-target'}
  id="newsletter-form"
  class="flex flex-col gap-2 sm:flex-row"
>
  {usingWeb3 && <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />}
  {usingWeb3 && <input type="hidden" name="subject" value="New The Sparrow Monthly signup" />}
  {usingWeb3 && <input type="hidden" name="redirect" value={`${SITE.url}/thank-you`} />}
  {usingWeb3 && <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />}
  {/* Brevo's own honeypot + required locale field, matching its generated form exactly. */}
  {!usingWeb3 && <input type="text" name="email_address_check" value="" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />}
  {!usingWeb3 && <input type="hidden" name="locale" value="en" />}

  <label class="sr-only" for="nl-email">Email address</label>
  <input
    id="nl-email"
    type="email"
    name={usingWeb3 ? 'email' : 'EMAIL'}
    required
    placeholder="you@example.com"
    class="field-input sm:flex-1"
  />
  <button type="submit" class="btn-primary !px-5 !py-2 text-sm">Subscribe</button>
</form>

{!usingWeb3 && <iframe name="newsletter-target" class="hidden" aria-hidden="true" tabindex="-1"></iframe>}

{!usingWeb3 && (
  <script>
    // Brevo's form posts here, inside a hidden iframe, so the visitor never leaves the site to
    // see Brevo's own unbranded raw JSON response. Once that hidden submission finishes loading,
    // send the visitor to our own branded confirmation page instead.
    const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
    const iframe = document.querySelector('iframe[name="newsletter-target"]') as HTMLIFrameElement | null;
    let submitted = false;
    form?.addEventListener('submit', () => {
      submitted = true;
    });
    iframe?.addEventListener('load', () => {
      if (submitted) {
        window.location.href = '/subscribed';
      }
    });
  </script>
)}
