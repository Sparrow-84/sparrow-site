---
import { WEB3FORMS_KEY } from '../../consts';
---

<form id="volunteer-form" action="https://api.web3forms.com/submit" method="POST" class="space-y-4" novalidate>
  <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
  <input type="hidden" name="subject" value="New volunteer interest from sparrowinc.org" />
  <input type="hidden" name="from_name" value="Sparrow Website" />
  <input id="v-redirect" type="hidden" name="redirect" value="/thank-you" />
  <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label class="field-label field-label-required" for="v-name">Your name</label>
      <input id="v-name" class="field-input" type="text" name="name" required autocomplete="name" />
    </div>
    <div>
      <label class="field-label field-label-required" for="v-email">Email</label>
      <input id="v-email" class="field-input" type="email" name="email" required autocomplete="email" />
    </div>
  </div>

  <div>
    <label class="field-label" for="v-phone">Phone (optional)</label>
    <input id="v-phone" class="field-input" type="tel" name="phone" autocomplete="tel" />
  </div>

  <div>
    <label class="field-label" for="v-interest">How would you like to help?</label>
    <select id="v-interest" class="field-input" name="interest">
      <option>Wherever I'm needed</option>
      <option>Work crews &amp; projects</option>
      <option>Providing meals</option>
      <option>Restocking homes</option>
      <option>Financial mentorship</option>
      <option>Peer support</option>
      <option>Service Volunteer Program (live-in)</option>
    </select>
  </div>

  <div>
    <label class="field-label" for="v-message">Anything you'd like us to know?</label>
    <textarea id="v-message" class="field-input" name="message" rows="4"></textarea>
  </div>

  <button type="submit" class="btn-primary">I'm interested</button>
  <p class="text-xs text-sparrow-gray dark:text-dark-muted">
    We'll follow up personally to find the right fit — at Sparrow, volunteering is relationship first.
  </p>
</form>

<script>
  // Mirrors the red-outline + "Required" caption pattern used across the staff/LCP portals.
  const form = document.getElementById('volunteer-form');
  if (form) {
    const redirectField = document.getElementById('v-redirect') as HTMLInputElement | null;
    if (redirectField) redirectField.value = `${window.location.origin}/thank-you`;

    // Pressing "back" after a successful submit can restore this page from the browser's
    // cache with the old entries still filled in, looking like it was never sent. Reset it
    // so the form is visibly empty again, not just stale-looking.
    window.addEventListener('pageshow', (e) => {
      if ((e as PageTransitionEvent).persisted) form.reset();
    });

    const requiredFields = Array.from(form.querySelectorAll('[required]'));

    function fieldInvalid(field: HTMLInputElement | HTMLTextAreaElement) {
      return field.value.trim().length === 0;
    }

    function setFieldError(field: HTMLInputElement | HTMLTextAreaElement, show: boolean) {
      field.classList.toggle('field-input-error', show);
      const errorId = `${field.id}-error`;
      let errorEl = document.getElementById(errorId);
      if (show && !errorEl) {
        errorEl = document.createElement('p');
        errorEl.id = errorId;
        errorEl.className = 'mt-1 text-xs text-red-600';
        errorEl.textContent = 'Required';
        field.insertAdjacentElement('afterend', errorEl);
      } else if (!show && errorEl) {
        errorEl.remove();
      }
    }

    requiredFields.forEach((field) => {
      field.addEventListener('input', () => {
        if (!fieldInvalid(field as HTMLInputElement | HTMLTextAreaElement)) {
          setFieldError(field as HTMLInputElement | HTMLTextAreaElement, false);
        }
      });
    });

    form.addEventListener('submit', (e) => {
      const invalidFields = requiredFields.filter((field) => {
        const invalid = fieldInvalid(field as HTMLInputElement | HTMLTextAreaElement);
        setFieldError(field as HTMLInputElement | HTMLTextAreaElement, invalid);
        return invalid;
      });
      const firstInvalid = invalidFields[0] as HTMLElement | undefined;
      if (firstInvalid) {
        e.preventDefault();
        firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
        firstInvalid.focus();
      }
    });
  }
</script>
