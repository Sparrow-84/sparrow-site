---
import { WEB3FORMS_KEY, SITE, CONTACT } from '../../consts';
---

<form action="https://api.web3forms.com/submit" method="POST" class="space-y-4">
  <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
  <input type="hidden" name="subject" value="New message from sparrowinc.org" />
  <input type="hidden" name="from_name" value="Sparrow Website" />
  <input type="hidden" name="redirect" value={`${SITE.url}/thank-you`} />
  <!-- honeypot: bots fill this in, people don't -->
  <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label class="field-label" for="c-name">Your name</label>
      <input id="c-name" class="field-input" type="text" name="name" required autocomplete="name" />
    </div>
    <div>
      <label class="field-label" for="c-email">Email</label>
      <input id="c-email" class="field-input" type="email" name="email" required autocomplete="email" />
    </div>
  </div>

  <div>
    <label class="field-label" for="c-topic">What's this about?</label>
    <select id="c-topic" class="field-input" name="topic">
      <option>General</option>
      <option>Twin Oaks housing</option>
      <option>LifeChange Program</option>
      <option>Volunteering</option>
      <option>Partnership</option>
    </select>
  </div>

  <div>
    <label class="field-label" for="c-message">Message</label>
    <textarea id="c-message" class="field-input" name="message" rows="5" required></textarea>
  </div>

  <button type="submit" class="btn-primary">Send message</button>
  <p class="text-xs text-sparrow-gray dark:text-dark-muted">
    A real person reads every message, and we'll reply personally. Prefer to call?
    {' '}{CONTACT.twinOaks.phone} (Twin Oaks) · {CONTACT.lifeChange.phone} (LifeChange).
  </p>
</form>
