---
import { WEB3FORMS_KEY } from '../../consts';
---

<form id="contact-form" action="https://api.web3forms.com/submit" method="POST" class="space-y-4" novalidate>
  <input type="hidden" name="access_key" value={WEB3FORMS_KEY} />
  <input type="hidden" name="subject" value="New message from sparrowinc.org" />
  <input type="hidden" name="from_name" value="Sparrow Website" />
  {/* Value is set at submit time to the current origin, so this always lands on this same site's
      own thank-you page — whether that's the staging URL today or sparrowinc.org after the domain switch. */}
  <input id="c-redirect" type="hidden" name="redirect" value="/thank-you" />
  <!-- honeypot: bots fill this in, people don't -->
  <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label class="field-label field-label-required" for="c-name">Your name</label>
      <input id="c-name" class="field-input" type="text" name="name" required autocomplete="name" />
    </div>
    <div>
      <label class="field-label field-label-required" for="c-email">Email</label>
      <input id="c-email" class="field-input" type="email" name="email" required autocomplete="email" />
    </div>
  </div>

  <div>
    <label class="field-label" for="c-topic">What's this about?</label>
    <select id="c-topic" class="field-input" name="topic">
      <option>General</option>
      <option>Twin Oaks housing</option>
      <option>LifeChange Program</option>
      <option>Volunteering</option>
      <option>Partnership</option>
    </select>
  </div>

  <div>
    <label class="field-label field-label-required" for="c-message">Message</label>
    <textarea id="c-message" class="field-input" name="message" rows="5" required></textarea>
  </div>

  <button type="submit" class="btn-primary">Send message</button>
  <p class="text-xs text-sparrow-gray dark:text-dark-muted">
    A real person reads every message, and we'll reply personally.
  </p>
</form>

<script>
  // Mirrors the red-outline + "Required" caption pattern used across the staff/LCP portals.
  const form = document.getElementById('contact-form');
  if (form) {
    const redirectField = document.getElementById('c-redirect') as HTMLInputElement | null;
    if (redirectField) redirectField.value = `${window.location.origin}/thank-you`;

    // Pressing "back" after a successful submit can restore this page from the browser's
    // cache with the old message still filled in, looking like it was never sent. Reset it
    // so the form is visibly empty again, not just stale-looking.
    window.addEventListener('pageshow', (e) => {
      if ((e as PageTransitionEvent).persisted) form.reset();
    });

    const requiredFields = Array.from(form.querySelectorAll('[required]'));

    function fieldInvalid(field: HTMLInputElement | HTMLTextAreaElement) {
      return field.value.trim().length === 0;
    }

    function setFieldError(field: HTMLInputElement | HTMLTextAreaElement, show: boolean) {
      field.classList.toggle('field-input-error', show);
      const errorId = `${field.id}-error`;
      let errorEl = document.getElementById(errorId);
      if (show && !errorEl) {
        errorEl = document.createElement('p');
        errorEl.id = errorId;
        errorEl.className = 'mt-1 text-xs text-red-600';
        errorEl.textContent = 'Required';
        field.insertAdjacentElement('afterend', errorEl);
      } else if (!show && errorEl) {
        errorEl.remove();
      }
    }

    requiredFields.forEach((field) => {
      field.addEventListener('input', () => {
        if (!fieldInvalid(field as HTMLInputElement | HTMLTextAreaElement)) {
          setFieldError(field as HTMLInputElement | HTMLTextAreaElement, false);
        }
      });
    });

    form.addEventListener('submit', (e) => {
      const invalidFields = requiredFields.filter((field) => {
        const invalid = fieldInvalid(field as HTMLInputElement | HTMLTextAreaElement);
        setFieldError(field as HTMLInputElement | HTMLTextAreaElement, invalid);
        return invalid;
      });
      const firstInvalid = invalidFields[0] as HTMLElement | undefined;
      if (firstInvalid) {
        e.preventDefault();
        firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
        firstInvalid.focus();
      }
    });
  }
</script>
