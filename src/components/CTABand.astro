---
interface Props {
  title: string;
  text?: string;
}
const { title, text } = Astro.props;
---

<section class="bg-sparrow-green">
  <div class="mx-auto max-w-content px-4 py-14 text-center sm:px-6">
    <h2 class="font-serif text-3xl font-semibold text-white">{title}</h2>
    {text && <p class="mx-auto mt-3 max-w-2xl text-white/85">{text}</p>}
    <div class="mt-6 flex flex-wrap justify-center gap-3"><slot /></div>
  </div>
</section>
