---
// Click-to-play video player. The clip itself is silent, so nothing autoplays —
// the file (13.7 MB) is only fetched when the visitor presses play
// (preload="none"). Works with no JS: the native <video> shows the branded
// poster and its own play control. When JS runs, a styled overlay replaces the
// native control for an on-brand play button; clicking it starts playback.
interface Props {
  src: string;
  poster?: string;
  /** Visible caption on the play button (e.g. duration hint). */
  caption?: string;
  /** Accessible description of the clip for screen readers. */
  label?: string;
  width?: number;
  height?: number;
}
const {
  src,
  poster,
  caption = 'Watch the clip',
  label = 'Play video',
  width = 1280,
  height = 720,
} = Astro.props;
---

<figure class="mx-auto max-w-4xl">
  <div class="relative aspect-video overflow-hidden rounded-2xl shadow-card">
    <video
      data-clip
      class="absolute inset-0 h-full w-full bg-sparrow-green object-cover"
      controls
      preload="none"
      playsinline
      poster={poster}
      width={width}
      height={height}
    >
      <source src={src} type="video/webm" />
      <p class="flex h-full items-center justify-center p-6 text-center text-white">
        Your browser can&rsquo;t play this video.
        <a href={src} class="ml-1 underline">Download it instead.</a>
      </p>
    </video>

    <!-- Branded play overlay — hidden until JS reveals it, so no-JS visitors get the native control. -->
    <button
      type="button"
      data-clip-play
      hidden
      aria-label={label}
      class="group absolute inset-0 flex flex-col items-center justify-center gap-4 bg-gradient-to-br from-sparrow-green to-sparrow-green-dark transition focus-visible:ring-2 focus-visible:ring-sparrow-gold focus-visible:ring-offset-2"
    >
      <span
        class="flex h-20 w-20 items-center justify-center rounded-full bg-sparrow-gold shadow-card transition group-hover:scale-105"
      >
        <svg width="32" height="32" viewBox="0 0 24 24" fill="#1A1A1A" aria-hidden="true">
          <path d="M8 5v14l11-7z" />
        </svg>
      </span>
      <span class="font-sans text-sm font-medium uppercase tracking-wide text-white/80">{caption}</span>
    </button>
  </div>
</figure>

<script is:inline>
  document.querySelectorAll('[data-clip-play]').forEach(function (btn) {
    btn.hidden = false; // JS is active — show the branded overlay instead of the native control
    btn.addEventListener('click', function () {
      var video = btn.closest('figure').querySelector('[data-clip]');
      btn.style.display = 'none';
      if (video) {
        video.play();
      }
    });
  });
</script>
