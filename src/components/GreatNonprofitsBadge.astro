---
import { GREATNONPROFITS } from '../consts';

interface Props {
  /** Rendered width/height in px — match the Candid seal next to it. */
  size?: number;
}
const { size = 96 } = Astro.props;
const count = GREATNONPROFITS.fiveStarReviews;
const star =
  'M10 1.5l2.6 5.3 5.9.9-4.25 4.1 1 5.8L10 14.9l-5.25 2.75 1-5.8L1.5 7.7l5.9-.9z';
---

<!-- Our own badge on purpose: GreatNonprofits' embed code loads ad/analytics tracking.
     See GREATNONPROFITS in consts.ts for how to keep the count current. -->
<a
  href={GREATNONPROFITS.profileUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${count} five-star reviews of Sparrow on GreatNonprofits (opens in a new tab)`}
  class="flex shrink-0 flex-col items-center justify-center gap-1.5 rounded-lg border-2 border-sparrow-green bg-white text-sparrow-ink no-underline transition hover:shadow-card"
  style={`width:${size}px;height:${size}px`}
>
  <span class="text-[10px] font-semibold text-sparrow-green">GreatNonprofits</span>
  <span class="flex gap-px" aria-hidden="true">
    {[0, 1, 2, 3, 4].map(() => (
      <svg viewBox="0 0 20 20" fill="#F0A500" class="h-3.5 w-3.5"><path d={star} /></svg>
    ))}
  </span>
  <span class="text-center text-[11px] font-semibold leading-tight">
    {count} five-star<br />reviews
  </span>
</a>
