---
import type { CollectionEntry } from 'astro:content';

interface Props {
  faqs: CollectionEntry<'faqs'>[];
}
const { faqs } = Astro.props;
const sorted = [...faqs].sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
  sorted.map(async (f) => ({ question: f.data.question, Content: (await f.render()).Content }))
);
---

<div class="divide-y divide-sparrow-rule dark:divide-dark-rule overflow-hidden rounded-2xl border border-sparrow-rule dark:border-dark-rule bg-white dark:bg-dark-surface">
  {
    rendered.map(({ question, Content }) => (
      <details class="group p-5">
        <summary class="flex cursor-pointer list-none items-center justify-between font-sans font-medium text-sparrow-ink dark:text-dark-text [&::-webkit-details-marker]:hidden">
          {question}
          <span class="ml-4 text-xl text-sparrow-gold transition group-open:rotate-45">+</span>
        </summary>
        <div class="mt-3 leading-relaxed text-sparrow-gray dark:text-dark-muted">
          <Content />
        </div>
      </details>
    ))
  }
</div>
