---
import { CANDID } from '../consts';

interface Props {
  /** Rendered width/height in px (the seal is square). */
  size?: number;
  class?: string;
}
const { size = 96, class: className = '' } = Astro.props;
---

<!-- Live image from Candid: updates its tier and year on its own. White tile in dark mode
     because the seal's lettering is near-black. -->
<a
  href={CANDID.profileUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Sparrow's Candid profile (opens in a new tab)"
  class={`inline-block shrink-0 rounded-lg dark:bg-white dark:p-1 ${className}`}
>
  <img
    src={CANDID.sealSrc}
    alt="Candid Seal of Transparency"
    width={size}
    height={size}
    loading="lazy"
    class="block"
    style={`width:${size}px;height:${size}px`}
  />
</a>
