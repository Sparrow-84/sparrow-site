---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="rounded-2xl border border-sparrow-rule dark:border-dark-rule bg-white dark:bg-dark-surface p-6 shadow-card">
  <h3 class="font-serif text-lg font-semibold">{title}</h3>
  <div class="mt-2 text-sm leading-relaxed text-sparrow-gray dark:text-dark-muted"><slot /></div>
</div>
