---
import { GIVEBUTTER } from '../consts';

interface Props {
  class?: string;
  onDark?: boolean;
}
const { class: className = '', onDark = false } = Astro.props;
---

<div class={`flex flex-wrap gap-3 ${className}`}>
  <a href={GIVEBUTTER.communityCenter} class="btn-gold" target="_blank" rel="noopener">
    Give to the Community Center
  </a>
  <a href={GIVEBUTTER.hopeFund} class={onDark ? 'btn-gold' : 'btn-outline'} target="_blank" rel="noopener">
    Give to the Hope Fund
  </a>
</div>
