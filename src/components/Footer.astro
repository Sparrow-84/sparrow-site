---
import { SITE, ORG, CONTACT, SOCIAL, NAV } from '../consts';
import NewsletterForm from './forms/NewsletterForm.astro';

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-sparrow-rule bg-sparrow-mist dark:border-dark-rule dark:bg-dark-surface">
  <div class="mx-auto grid max-w-content gap-10 px-4 py-12 sm:px-6 md:grid-cols-4">

    <div>
      <div class="flex items-center gap-2.5">
        <img src="/brand/logo-primary-circle-green.png" alt="" width="40" height="40" class="h-10 w-10" />
        <span class="font-serif text-lg font-semibold text-sparrow-green dark:text-dark-heading">{SITE.shortName}</span>
      </div>
      <p class="mt-3 text-sm text-sparrow-gray dark:text-dark-muted">{SITE.tagline}</p>
      <p class="mt-3 text-sm text-sparrow-gray dark:text-dark-muted">
        {ORG.address.street}<br />
        {ORG.address.city}, {ORG.address.state} {ORG.address.zip}
      </p>
    </div>

    <nav aria-label="Footer" class="text-sm">
      <h2 class="font-sans font-semibold text-sparrow-green dark:text-dark-heading">Explore</h2>
      <ul class="mt-3 space-y-2">
        {NAV.map((i) => (
          <li><a href={i.href} class="text-sparrow-ink dark:text-dark-text hover:text-sparrow-green dark:hover:text-dark-heading">{i.label}</a></li>
        ))}
        <li class="border-t border-sparrow-rule pt-3 mt-3 dark:border-dark-rule">
          <a href="/login" class="inline-flex items-center rounded-full bg-sparrow-gold px-3 py-0.5 font-semibold text-sparrow-ink hover:opacity-90">Login</a>
        </li>
      </ul>
    </nav>

    <div class="text-sm">
      <h2 class="font-sans font-semibold text-sparrow-green dark:text-dark-heading">Connect</h2>
      <ul class="mt-3 space-y-2.5 text-sparrow-ink dark:text-dark-text">
        <li>
          <a href={`mailto:${CONTACT.general.email}`} class="flex items-center gap-2 hover:text-sparrow-green dark:hover:text-dark-heading">
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 shrink-0 text-sparrow-green dark:text-dark-heading">
              <path d="M3 4a2 2 0 0 0-2 2v1.161l8.441 4.221a1.25 1.25 0 0 0 1.118 0L19 7.162V6a2 2 0 0 0-2-2H3Z" />
              <path d="m19 8.839-7.77 3.885a2.75 2.75 0 0 1-2.46 0L1 8.839V14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8.839Z" />
            </svg>
            {CONTACT.general.email}
          </a>
        </li>
        <li>
          <a href={`tel:${CONTACT.twinOaks.phone}`} class="flex items-center gap-2 hover:text-sparrow-green dark:hover:text-dark-heading">
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 shrink-0 text-sparrow-green dark:text-dark-heading">
              <path fill-rule="evenodd" d="M2 3.5A1.5 1.5 0 0 1 3.5 2h1.148a1.5 1.5 0 0 1 1.465 1.175l.716 3.223a1.5 1.5 0 0 1-1.052 1.767l-.933.267c-.41.117-.643.555-.48.95a11.542 11.542 0 0 0 6.254 6.254c.395.163.833-.07.95-.48l.267-.933a1.5 1.5 0 0 1 1.767-1.052l3.223.716A1.5 1.5 0 0 1 18 16.352V17.5a1.5 1.5 0 0 1-1.5 1.5H15c-1.149 0-2.263-.15-3.326-.43A13.022 13.022 0 0 1 2.43 8.326 13.019 13.019 0 0 1 2 5V3.5Z" clip-rule="evenodd" />
            </svg>
            Twin Oaks: {CONTACT.twinOaks.phone}
          </a>
        </li>
        <li>
          <a href={`tel:${CONTACT.lifeChange.phone}`} class="flex items-center gap-2 hover:text-sparrow-green dark:hover:text-dark-heading">
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 shrink-0 text-sparrow-green dark:text-dark-heading">
              <path fill-rule="evenodd" d="M2 3.5A1.5 1.5 0 0 1 3.5 2h1.148a1.5 1.5 0 0 1 1.465 1.175l.716 3.223a1.5 1.5 0 0 1-1.052 1.767l-.933.267c-.41.117-.643.555-.48.95a11.542 11.542 0 0 0 6.254 6.254c.395.163.833-.07.95-.48l.267-.933a1.5 1.5 0 0 1 1.767-1.052l3.223.716A1.5 1.5 0 0 1 18 16.352V17.5a1.5 1.5 0 0 1-1.5 1.5H15c-1.149 0-2.263-.15-3.326-.43A13.022 13.022 0 0 1 2.43 8.326 13.019 13.019 0 0 1 2 5V3.5Z" clip-rule="evenodd" />
            </svg>
            LifeChange: {CONTACT.lifeChange.phone}
          </a>
        </li>
        <li class="flex gap-4 pt-1">
          <a
            href={SOCIAL.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Sparrow on Facebook"
            class="hover:text-sparrow-green dark:hover:text-dark-heading"
          >
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
          <a
            href={SOCIAL.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Sparrow on Instagram"
            class="hover:text-sparrow-green dark:hover:text-dark-heading"
          >
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
            </svg>
          </a>
        </li>
      </ul>
    </div>

    <div class="text-sm">
      <h2 class="font-sans font-semibold text-sparrow-green dark:text-dark-heading">The Sparrow Monthly</h2>
      <p class="mt-3 text-sparrow-gray dark:text-dark-muted">Prayer requests, community updates, and news.</p>
      <div class="mt-3"><NewsletterForm /></div>
    </div>
  </div>

  <div class="border-t border-sparrow-rule dark:border-dark-rule">
    <div class="mx-auto flex max-w-content flex-col gap-2 px-4 py-5 text-xs text-sparrow-gray dark:text-dark-muted sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <p>
        © {year} {ORG.legalName} · A 501(c)(3) nonprofit · Corvallis, Oregon ·
        <a href="/privacy" class="underline hover:text-sparrow-green dark:hover:text-dark-heading">Privacy Policy</a>
      </p>
      <p class="italic">{SITE.verse}</p>
    </div>
  </div>
</footer>
