---
import type { CollectionEntry } from 'astro:content';

interface Props {
  stats: CollectionEntry<'stats'>[];
}
const { stats } = Astro.props;
const sorted = [...stats].sort((a, b) => a.data.order - b.data.order);
const sources = sorted.map((s) => s.data.source).filter((s): s is string => !!s);
---

<div class="grid gap-8 sm:grid-cols-3">
  {
    sorted.map((s) => (
      <div class="text-center">
        <p class="font-serif text-5xl font-semibold text-sparrow-gold">{s.data.value}</p>
        <p class="mt-2 text-sparrow-ink/80 dark:text-dark-text/80" set:html={s.data.label} />
      </div>
    ))
  }
</div>
{
  sources.length > 0 && (
    <p class="mt-8 text-center text-[10px] text-sparrow-gray dark:text-dark-muted">
      Sources: {sources.join(' · ')}
    </p>
  )
}
